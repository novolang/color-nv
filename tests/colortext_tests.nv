@test
fn test_every_colour_with_exactly_one_name_answers_it() [io]
    test.case("the 139 distinct values, each naming the spelling CSS lists first")
    spelling(0xf0f8ff, "aliceblue")
    spelling(0xfaebd7, "antiquewhite")
