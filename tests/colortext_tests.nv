    spelling(0xffff00, "yellow")
    spelling(0x9acd32, "yellowgreen")

    test.case("and the nine duplicated values answer the first spelling, not the second")
    test.assert(named_is(colortext.name_of(Srgb8 { r: 128, g: 128, b: 128 }), "gray"))
    test.assert(named_is(colortext.name_of(Srgb8 { r: 0, g: 255, b: 255 }), "aqua"))
    test.assert(named_is(colortext.name_of(Srgb8 { r: 255, g: 0, b: 255 }), "fuchsia"))

// One keyword.  The table holds it at the value CSS publishes, and it
// is fully opaque, because only `transparent` is not.
fn keyword(name: Str, packed: Int) [io]
    match colortext.named(name)
        Some(p) => test.assert(srgb.pack_rgb(p.rgb) == packed and p.a == 255)
        None    => test.fail("`${name}` is missing from the table")

// One value.  The reverse table names it, and the name reads back as
// the same value.
fn spelling(packed: Int, name: Str) [io]
    match colortext.name_of(srgb.unpack_rgb(packed))
        Some(n) => test.assert_eq_str(n, name)
        None    => test.fail("`${name}` has no reverse entry")

// Whether an optional name is a particular one.
fn named_is(got: ?Str, want: Str) -> Bool
    match got
        Some(n) => n == want
        None    => false

// ── Every refusal, and every path through the grammar ────────────────

@test
fn test_parse_reads_the_hex_forms_too_and_not_only_parse_hex() [io]
    test.case("the front door takes a # form as readily as a name")
    match colortext.parse("#00ff00")
        Ok(p)  => test.assert(p.rgb.g == 255 and p.a == 255)
        Err(_) => test.fail("#00ff00 refused by parse")

    test.case("upper case digits are digits, which is not the strictness this parser is for")
    match colortext.parse_hex("#C0FFEE")
        Ok(p)  => test.assert(p.rgb.r == 192 and p.rgb.g == 255 and p.rgb.b == 238)
        Err(_) => test.fail("#C0FFEE refused")

    test.case("the four-digit form carries an alpha, doubled like the other three digits")
    match colortext.parse_hex("#f0c8")
        Ok(p)  => test.assert(p.rgb.r == 255 and p.rgb.b == 204 and p.a == 136)
        Err(_) => test.fail("#f0c8 refused")

    test.case("leading space is ignored, and the offsets still count from the caller's own text")
    match colortext.parse("  #12345")
        Ok(_)                            => test.fail("#12345 accepted")
        Err(ColorBadHexLength(off, len)) => test.assert(off == 2 and len == 5)
        Err(_)                           => test.fail("refused for the wrong reason")

@test
fn test_parse_hex_refuses_what_is_not_a_hex_form_at_all() [io]
    test.case("an empty string has its own variant here too")
    match colortext.parse_hex("")
        Ok(_)                => test.fail("the empty string accepted")
        Err(ColorEmptyInput) => test.assert(true)
        Err(_)               => test.fail("refused for the wrong reason")

    test.case("a name is a colour to `parse` and not a hex form to `parse_hex`")
    match colortext.parse_hex("red")
        Ok(_)                       => test.fail("`red` accepted by parse_hex")
        Err(ColorUnrecognised(off)) => test.assert(off == 0)
        Err(_)                      => test.fail("refused for the wrong reason")

@test
fn test_the_functional_forms_read_percentages_slashes_and_degrees() [io]
    test.case("percentage channels are a percentage of 255")
    match colortext.parse("rgb(100% 0% 0%)")
        Ok(p)  => test.assert(p.rgb.r == 255 and p.rgb.g == 0)
        Err(_) => test.fail("rgb(100% 0% 0%) refused")

    test.case("the slash form carries the alpha as a unit fraction")
    match colortext.parse("rgb(255 0 0 / 0.5)")
        Ok(p)  => test.assert(p.a == 128)
        Err(_) => test.fail("the slash alpha refused")

    test.case("and as a percentage, which is the same quantity spelled twice")
    match colortext.parse("rgba(255, 0, 0, 50%)")
        Ok(p)  => test.assert(p.a == 128)
        Err(_) => test.fail("the percentage alpha refused")

    test.case("a hue may carry its unit, which CSS permits and this reads")
    match colortext.parse("hsl(120deg 100% 50%)")
        Ok(p)  => test.assert(p.rgb.g == 255 and p.rgb.r == 0)
        Err(_) => test.fail("hsl(120deg …) refused")

    test.case("and hsla takes a fourth argument like rgba does")
    match colortext.parse("hsla(0, 100%, 50%, 0.5)")
        Ok(p)  => test.assert(p.rgb.r == 255 and p.a == 128)
        Err(_) => test.fail("hsla(…) refused")

@test
fn test_every_way_a_functional_form_can_be_wrong_has_its_own_answer() [io]
    test.case("a channel that is not a number at all")
    expect_bad_function("rgb(x 0 0)", "rgb")

    test.case("the wrong number of arguments")
    expect_bad_function("rgb(1 2)", "rgb")
    expect_bad_function("hsl(1 2)", "hsl")

    test.case("an alpha that is not a number")
    expect_bad_function("rgb(255 0 0 / x)", "rgb")

    test.case("a saturation and a hue that are not numbers")
    expect_bad_function("hsl(0 x% 50%)", "hsl")
    expect_bad_function("hsl(x 100% 50%)", "hsl")

    test.case("an unclosed hsl( names hsl, not rgb")
    expect_bad_function("hsl(0 100% 50%", "hsl")

@test
fn test_every_channel_out_of_range_reports_the_value_that_was_read() [io]
    test.case("a byte above 255 and a percentage above 100")
    expect_out_of_range("rgb(300 0 0)", 300.0)
    expect_out_of_range("rgb(150% 0 0)", 150.0)

    test.case("a negative channel, which CSS clamps and this refuses")
    expect_out_of_range("rgb(-1 0 0)", -1.0)

    test.case("an alpha above one, and a percentage alpha above a hundred")
    expect_out_of_range("rgb(255 0 0 / 2)", 2.0)
    expect_out_of_range("rgb(255 0 0 / 150%)", 150.0)

    test.case("and a saturation outside its own range")
    expect_out_of_range("hsl(0 150% 50%)", 150.0)

@test
fn test_every_error_carries_its_offset_and_says_what_it_is() [io]
    test.case("error_offset answers for every variant, including the one with no input")
    test.assert(colortext.error_offset(ColorEmptyInput) == 0)
    test.assert(colortext.error_offset(ColorBadHexLength(1, 5)) == 1)
    test.assert(colortext.error_offset(ColorBadHexDigit(2, 122)) == 2)
    test.assert(colortext.error_offset(ColorUnrecognised(3)) == 3)
    test.assert(colortext.error_offset(ColorUnknownName(4, "burgundy")) == 4)
    test.assert(colortext.error_offset(ColorBadFunction(5, "rgb")) == 5)
    test.assert(colortext.error_offset(ColorChannelOutOfRange(6, 300.0)) == 6)
    test.assert(colortext.error_offset(ColorUnsupportedSpace(7, "lch")) == 7)

    test.case("and every variant prints a sentence naming the rule it is about")
    test.assert(str.contains(ColorEmptyInput.message(), "no text"))
    test.assert(str.contains(ColorBadHexLength(1, 5).message(), "5"))
    test.assert(str.contains(ColorBadHexDigit(2, 122).message(), "z"))
    test.assert(str.contains(ColorUnrecognised(3).message(), "not a colour"))
    test.assert(str.contains(ColorBadFunction(5, "rgb").message(), "rgb()"))
    test.assert(str.contains(ColorChannelOutOfRange(6, 300.0).message(), "300"))
    test.assert(str.contains(ColorUnsupportedSpace(7, "lch").message(), "lch()"))

@test
fn test_an_unknown_name_is_offered_the_keyword_it_was_probably_meant_to_be() [io]
    test.case("`burgundy` shares three letters with `burlywood` and nothing shares more")
    test.assert(str.contains(ColorUnknownName(0, "burgundy").message(), "burlywood"))

    test.case("a name sharing nothing with the table is told so without a guess")
    let lonely = ColorUnknownName(0, "zzzz").message()
    test.assert(str.contains(lonely, "zzzz"))
    test.assert(str.contains(lonely, "did you mean") == false)

@test
fn test_the_formatters_write_the_shortest_form_that_reads_back_the_same() [io]
    test.case("an alpha of 1 needs three decimals and an alpha of 128 needs one")
    test.assert_eq_str(colortext.format_rgba(srgb.with_alpha(srgb.black(), 1)),
                       "rgb(0 0 0 / 0.004)")
    test.assert_eq_str(colortext.format_rgba(srgb.with_alpha(srgb.black(), 128)),
                       "rgb(0 0 0 / 0.5)")

    test.case("and an alpha of 0 needs none at all")
    test.assert_eq_str(colortext.format_rgba(srgb.transparent()), "rgb(0 0 0 / 0)")

    test.case("hsl writes a fractional hue only where the colour has one")
    test.assert_eq_str(colortext.format_hsl(Srgb8 { r: 0, g: 0, b: 255 }), "hsl(240 100% 50%)")
    test.assert_eq_str(colortext.format_hsl(Srgb8 { r: 200, g: 100, b: 50 }),
                       "hsl(20 60% 49.02%)")

    test.case("and the eight-digit hex form is the six-digit one with the alpha after it")
    test.assert_eq_str(colortext.format_hex_alpha(srgb.with_alpha(Srgb8 { r: 0, g: 17, b: 34 }, 0)),
                       "#00112200")

@test
fn test_the_parse_and_format_round_trip_is_colour_exact() [io]
    test.case("every form of one colour reads back as the same three bytes")
    let c = Srgb8 { r: 200, g: 100, b: 50 }
    reads_back(colortext.format_hex(c), c)
    reads_back(colortext.format_rgb(c), c)
    reads_back(colortext.format_hsl(c), c)

    test.case("and the alpha survives the eight-digit form")
    match colortext.parse(colortext.format_hex_alpha(srgb.with_alpha(c, 128)))
        Ok(p)  => test.assert(p.a == 128 and p.rgb.r == 200)
        Err(_) => test.fail("the eight-digit form did not read back")

// A form that must refuse with `ColorBadFunction`, naming the grammar
// it was closest to.
fn expect_bad_function(text: Str, want: Str) [io]
    match colortext.parse(text)
        Ok(_)                          => test.fail("`${text}` accepted")
        Err(ColorBadFunction(_, name)) => test.assert_eq_str(name, want)
        Err(e)                         => test.fail("`${text}`: ${e.message()}")

// A form that must refuse with the value that was out of range.
fn expect_out_of_range(text: Str, want: Float) [io]
    match colortext.parse(text)
        Ok(_)                                 => test.fail("`${text}` accepted")
        Err(ColorChannelOutOfRange(_, value)) => test.assert_approx(value, want, 0.0000001)
        Err(e)                                => test.fail("`${text}`: ${e.message()}")

// Text that must read back as a particular colour.
fn reads_back(text: Str, want: Srgb8) [io]
    match colortext.parse(text)
        Ok(p)  => test.assert(srgb.same8(p.rgb, want))
        Err(e) => test.fail("`${text}`: ${e.message()}")

@test
fn test_a_bare_keyword_is_read_by_the_front_door_as_well() [io]
    test.case("`parse` of a name answers the colour the table holds")
    match colortext.parse("rebeccapurple")
        Ok(p)  => test.assert(p.rgb.r == 102 and p.rgb.g == 51 and p.rgb.b == 153 and p.a == 255)
        Err(_) => test.fail("rebeccapurple refused by parse")

    test.case("and `transparent` is the keyword whose alpha is not 255")
    match colortext.parse("transparent")
        Ok(p)  => test.assert(p.a == 0 and p.rgb.r == 0)
        Err(_) => test.fail("transparent refused by parse")

@test
fn test_a_percentage_with_one_decimal_keeps_it_and_drops_the_other() [io]
    test.case("a lightness of 0.196% writes as 0.2%, not 0.20% and not 0%")
    test.assert_eq_str(colortext.format_hsl(Srgb8 { r: 1, g: 0, b: 0 }), "hsl(0 100% 0.2%)")
