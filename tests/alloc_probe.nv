// tests/alloc_probe.nv — the program `tests/alloc_scan.sh` compiles to
// read the emitted LLVM for `novo_alloc`.
//
// The conversion path allocates nothing.  A colour decoded into the
// working types travels through linear RGB, XYZ, Lab, Oklab, HSL and
// HSV and back without touching the heap once.  That is what makes
// `Srgb`, `Alpha` and the five space types worth their `@value`
// annotation.  It is a fact about compiled output rather than about
// source, so it is checked by reading the compiled output.
//
// This file makes every function of that path appear in one module's IR
// under its own name.  It is built with `--opt=0` for that reason.  At
// the default optimisation level the whole thing inlines into
// `novo_main`, there is nothing left to attribute an allocation to, and
// an assertion that no conversion allocates would pass over an empty
// file.
//
// `srgb.to_srgb8`, `rgb8`, `with_alpha` and their siblings do allocate.
// They construct an `Srgb8` or an `Srgba8`, which are boxed structs
// because storage crosses boundaries an unboxed struct could not, as
// the header of `src/srgb.nv` says.  They are excluded by name in the
// scanner rather than by the probe quietly not calling them.
//
// The values are printed rather than checked, and the suites under
// `tests/` own correctness.  This one is here to be read as text.

use srgb
use colorspace

fn main() [io]
    // The whole path, from the bytes a file holds back to them.
    let start = srgb.to_srgb(Srgb8 { r: 200, g: 100, b: 50 })
    let light = colorspace.to_linear(start)
    let xyz = colorspace.to_xyz(light)
    let adapted = colorspace.adapt(xyz, WhiteD65, WhiteD50)
    let lab = colorspace.to_lab(adapted, WhiteD50)
    let back_xyz = colorspace.from_lab(lab, WhiteD50)
    let back_light = colorspace.from_xyz(colorspace.adapt(back_xyz, WhiteD50, WhiteD65))
    let encoded = colorspace.to_srgb(back_light)
    println("${encoded.r} ${encoded.g} ${encoded.b}")

    // The two cylindrical spaces, there and back.
    let hsl = colorspace.srgb_to_hsl(start)
    let hsv = colorspace.srgb_to_hsv(start)
    println("${colorspace.hsl_to_srgb(hsl).r} ${colorspace.hsv_to_srgb(hsv).r}")

    // Oklab, whose cube roots are the one place a conversion could
    // stage a value somewhere.
    let ok = colorspace.srgb_to_oklab(start)
    println("${colorspace.oklab_to_srgb(ok).r}")

    // The transfer function on its own, and the two clamps beside it.
    println("${colorspace.encode_channel(colorspace.decode_channel(0.5))}")
    println("${srgb.clamp_unit(1.4)} ${srgb.clamp_byte(300)}")

    // The white points and the predicates a caller reaches for.
    println("${colorspace.white_xyz(WhiteD65).y} ${colorspace.channel_count(SpaceOklab)}")
    println("${colorspace.is_linear(SpaceCieXyz)} ${colorspace.is_cylindrical(SpaceHsl)}")
