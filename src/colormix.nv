// colormix.nv — blending two colours, walking a ramp between several,
// and the premultiplication rules that decide whether a composite has
// a dark fringe around it.
//
// Every function here takes the space and none of them defaults it.
// Mixing red and green has at least four defensible answers, and they
// look different enough that a reader can tell them apart at a glance.
// In encoded sRGB the midpoint is a dark olive.  In linear RGB it is a
// bright olive.  In HSL it goes through yellow, and in Lab through a
// muted khaki.  None of them is the correct one, because they answer
// different questions, so every signature carries a `ColorSpace`.  A
// caller who does not know which they want wants `SpaceLinearRgb` for
// anything that models light, and `SpaceOklab` for anything a person
// will look at as a gradient.
//
// A hue interpolation takes the short way round the circle.  In a
// cylindrical space, which is `SpaceHsl` or `SpaceHsv`, the hue is an
// angle, so interpolating from 350° to 10° can go 20° forwards or 340°
// backwards.  This module goes forwards, which is CSS Color 4's
// `shorter hue` default and what a reader expects of a two-stop
// gradient.  It is also why a ramp through several stops is not the
// same as the two-at-a-time mixes it is made of, because each segment
// picks its own direction.  `mix_hue_long` is the escape for a caller
// who wants the long way.
//
// A blend between two pixels of different opacity has to happen on
// premultiplied values, or the transparent one's colour leaks in.
// Blending opaque red with transparent white unpremultiplied gives a
// pink at half coverage, which is the white fringe a naive compositor
// produces.  This module premultiplies internally for every pixel-level
// operation and hands back unassociated values, because unassociated is
// what PNG and QOI store.  `premultiply` and `unpremultiply` are
// published for the caller who is compositing a whole buffer and wants
// to pay for the conversion once.

use srgb
use colorspace
use std.math
use std.list

// Three channels of whatever space the caller named, with no memory of
// which space that was.
//
// Every space in this package carries exactly three numbers, which
// `colorspace.channel_count` is the published form of.  One private
// triple therefore lets `mix`, `lighten`, `saturate` and `rotate_hue`
// share a body instead of repeating seven conversions each.  It is
// `@value`, so the whole of a blend runs in registers and converting a
// colour into a space and back allocates nothing.
//
// The fields are `a`, `b` and `c` rather than named channels because
// the meaning changes with the space.  `a` is red in sRGB, the hue in
// HSL and L* in Lab, and a name that was right for one of those would
// be wrong in the other six.
@value
struct Chan
    a: Float
    b: Float
    c: Float

// A stored colour as three channels of a named space.
fn to_chan(c: Srgb8, space: ColorSpace) -> Chan
    let e = srgb.to_srgb(c)
    match space
        SpaceSrgb      => Chan { a: e.r, b: e.g, c: e.b }
        SpaceLinearRgb => of_linear(colorspace.to_linear(e))
        SpaceHsl       => of_hsl(colorspace.srgb_to_hsl(e))
        SpaceHsv       => of_hsv(colorspace.srgb_to_hsv(e))
        SpaceCieXyz    => of_xyz(colorspace.to_xyz(colorspace.to_linear(e)))
        SpaceCieLab    => of_lab(colorspace.to_lab(colorspace.to_xyz(colorspace.to_linear(e)), WhiteD65))
        SpaceOklab     => of_lab(colorspace.srgb_to_oklab(e))

// Three channels of a named space back to a stored colour.
//
// This is where the result comes home to eight bits a channel, so it is
// also where an out-of-gamut blend is clamped.  `srgb.to_srgb8` does
// the clamping, and its own documentation says why a byte has nowhere
// else to put the overflow.
fn from_chan(v: Chan, space: ColorSpace) -> Srgb8
    match space
        SpaceSrgb      => srgb.to_srgb8(Srgb { r: v.a, g: v.b, b: v.c })
        SpaceLinearRgb => srgb.to_srgb8(colorspace.to_srgb(LinearRgb { r: v.a, g: v.b, b: v.c }))
        SpaceHsl       => srgb.to_srgb8(colorspace.hsl_to_srgb(Hsl { h: v.a, s: v.b, l: v.c }))
        SpaceHsv       => srgb.to_srgb8(colorspace.hsv_to_srgb(Hsv { h: v.a, s: v.b, v: v.c }))
        SpaceCieXyz    => srgb.to_srgb8(colorspace.to_srgb(colorspace.from_xyz(CieXyz { x: v.a, y: v.b, z: v.c })))
        SpaceCieLab    => srgb.to_srgb8(colorspace.to_srgb(colorspace.from_xyz(colorspace.from_lab(CieLab { l: v.a, a: v.b, b: v.c }, WhiteD65))))
        SpaceOklab     => srgb.to_srgb8(colorspace.oklab_to_srgb(CieLab { l: v.a, a: v.b, b: v.c }))

// The four space types as a triple, one line each because a struct
// literal is not a pattern and the fields are named differently in
// every one of them.
fn of_linear(c: LinearRgb) -> Chan
    Chan { a: c.r, b: c.g, c: c.b }

fn of_hsl(c: Hsl) -> Chan
    Chan { a: c.h, b: c.s, c: c.l }

fn of_hsv(c: Hsv) -> Chan
    Chan { a: c.h, b: c.s, c: c.v }

fn of_xyz(c: CieXyz) -> Chan
    Chan { a: c.x, b: c.y, c: c.z }

fn of_lab(c: CieLab) -> Chan
    Chan { a: c.l, b: c.a, c: c.b }

// Linear interpolation that extrapolates.  A `t` outside `0.0 ..= 1.0`
// is a position past an end rather than an error, which is what `mix`
// documents and what a hover state one step past a token wants.
fn lerp(a: Float, b: Float, t: Float) -> Float
    a + (b - a) * t

// Interpolation around a hue circle, the short way or the long way.
//
// `short` is the signed difference folded into `-180.0 ..= 180.0`,
// which is the smaller of the two arcs between the hues.  The long way
// is the same arc with a full turn taken off it, in whichever direction
// leaves it going the other way round.  Two equal hues have a short
// difference of zero, so the long way between them is a whole 360
// degrees through every other hue.  That is CSS Color 4's rule and what
// a caller asking for `longer hue` between two reds means.
//
// Nothing is wrapped back into range here.  `colorspace.hsl_to_srgb`
// and `hsv_to_srgb` both wrap their own input, so a hue of 400 or -20
// is a legal intermediate.
fn lerp_hue(a: Float, b: Float, t: Float, long: Bool) -> Float
    let raw = b - a
    let short = raw - math.floor((raw + 180.0) / 360.0) * 360.0
    if not long
        a + short * t
    elif short > 0.0
        a + (short - 360.0) * t
    else
        a + (short + 360.0) * t

// The shared body of `mix` and `mix_hue_long`.
//
// The two differ in one boolean and nothing else, and the boolean
// reaches anything only in a cylindrical space.  The test below is why
// `mix_hue_long` in Lab behaves as `mix` does.
fn blend(a: Srgb8, b: Srgb8, t: Float, space: ColorSpace, long: Bool) -> Srgb8
    let x = to_chan(a, space)
    let y = to_chan(b, space)
    if colorspace.is_cylindrical(space)
        from_chan(Chan { a: lerp_hue(x.a, y.a, t, long),
                         b: lerp(x.b, y.b, t),
                         c: lerp(x.c, y.c, t) },
                         space)
    else
        from_chan(Chan { a: lerp(x.a, y.a, t),
                         b: lerp(x.b, y.b, t),
                         c: lerp(x.c, y.c, t) },
                         space)

// Move a channel a fraction of the way to the top of its scale, or a
// fraction of the way to the bottom.
//
// The step is asymmetric.  `amount` is a fraction of what is left in
// the direction of travel, so 1.0 always arrives at `top` and -1.0
// always arrives at zero, whatever the channel started at.  Two
// applications of 0.5 therefore do not reach the end.  That is the
// behaviour a design system's lighter token wants, and the reason this
// is not `mix(c, white, amount)`.
fn toward(v: Float, amount: Float, top: Float) -> Float
    if amount >= 0.0
        v + amount * (top - v)
    else
        v * (1.0 + amount)

// Which end of the scale a lighten is heading for.
fn ink(amount: Float) -> Srgb8
    if amount >= 0.0
        srgb.white()
    else
        srgb.black()

// Rotate the chroma plane of a Lab-like triple, leaving lightness alone.
//
// In L*a*b* and Oklab the hue is not a channel.  It is the angle of the
// (a, b) vector, so rotating it is a rotation of that plane.  The
// chroma, which is the vector's length, comes out unchanged, so the
// colour stays as vivid as it was.
fn spin(v: Chan, degrees: Float) -> Chan
    let rad = degrees * math.pi() / 180.0
    let cs = math.cos(rad)
    let sn = math.sin(rad)
    Chan { a: v.a, b: v.b * cs - v.c * sn, c: v.b * sn + v.c * cs }

// Advance the hue channel of a cylindrical triple.
//
// The angle is not folded back into range here.
// `colorspace.hsl_to_srgb` and `hsv_to_srgb` wrap their own input, so
// folding it here would be the same arithmetic twice.
fn turn(v: Chan, degrees: Float) -> Chan
    Chan { a: v.a + degrees, b: v.b, c: v.c }

// The colour between the two stops that bracket a position.
//
// It is only ever called with a position strictly inside the ramp and
// with at least two stops, which `sample` has already established.  The
// scan stops on the first pair whose upper stop is past `at`, so the
// span it divides by is always positive.  The loop advances only past a
// stop it has found to be at or before `at`, it stops at one that is
// after `at`, and no pair can be both.  Two stops at one position are
// therefore a hard edge rather than a division by zero.  The scan walks
// over the first of them and the second one wins, which is how a
// gradient implementation reads a repeated offset.
fn segment(stops: [ColorStop], at: Float, space: ColorSpace) -> Srgb8
    var i = 1
    for j in 1..list.len(stops) - 1
        if stops[j].at > at
            break
        i = j + 1
    let lo = stops[i - 1]
    let hi = stops[i]
    blend(lo.color, hi.color, (at - lo.at) / (hi.at - lo.at), space, false)

// Where entry `i` of an `n`-entry table sits in `0.0 ..= 1.0`.
//
// A table of one is the ramp at its start rather than at its middle.
// Dividing by `n - 1` would be a division by zero, and the first entry
// is the only answer that stays consistent as `n` grows.
fn position(i: Int, n: Int) -> Float
    if n <= 1
        0.0
    else
        i as Float / (n - 1) as Float

// One channel scaled by a factor, rounded and held inside a byte.
fn scale_byte(v: Int, factor: Float) -> Int
    srgb.clamp_byte(math.round(v as Float * factor) as Int)

// One channel of a Porter-Duff `over`, in linear light.
//
// The formula is `(cs * as + cd * ad * (1 - as)) / ao`.  It is the
// premultiplied form divided back out by the composite's own alpha,
// because the result is handed back unassociated.
fn composite(cs: Float, sa: Float, cd: Float, da: Float, oa: Float) -> Float
    (cs * sa + cd * da * (1.0 - sa)) / oa

// A stop in a colour ramp: a position and the colour at it.
//
// `at` runs `0.0 ..= 1.0`.  A ramp is a list of these, and this package
// requires them sorted.  The alternative is a sort inside every sample
// call, which would make sampling a ramp of `n` stops cost `n log n`
// per pixel.  `ramp_is_sorted` is how a caller checks once, at the
// point where the ramp is built.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     let s = ColorStop { at: 0.0, color: srgb.black() }
//     println("${s.at}")                                   // 0
// ```
pub struct ColorStop
    // Where in the ramp this stop sits, `0.0 ..= 1.0`.
    at: Float
    // The colour at that position.
    color: Srgb8

// Blend two colours in a named space.
//
// `t` is the position.  0.0 is `a` and 1.0 is `b`, and a value outside
// `0.0 ..= 1.0` extrapolates rather than clamping.  That is how a
// caller gets a colour ten percent past `b` for a hover state.  The
// result can therefore leave the gamut, and `srgb.to_srgb8` is where it
// comes back.
//
// The blend happens in `space` and the result is converted back to
// sRGB, so `mix(red, green, 0.5, SpaceSrgb)` and
// `mix(red, green, 0.5, SpaceLinearRgb)` are different colours and
// both are right answers to different questions.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     let c = colormix.mix(srgb.black(), srgb.white(), 0.0, SpaceLinearRgb)
//     println("${c.r}")                                    // 0
// ```
pub fn mix(a: Srgb8, b: Srgb8, t: Float, space: ColorSpace) -> Srgb8
    blend(a, b, t, space, false)

// Blend two pixels in a named space, premultiplying first.
//
// This is the pixel-level form, and the one to use whenever either
// operand has an alpha below 255.  The colours are premultiplied,
// blended and unpremultiplied on the way out.  The alphas are blended
// linearly and never converted, because coverage is not a colour.
//
// A result whose alpha is 0 has no recoverable colour, because every
// channel was multiplied by zero.  This function answers
// `srgb.transparent()` rather than a colour it would have had to
// invent.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     let p = colormix.mix_pixel(srgb.transparent(), srgb.opaque(srgb.white()), 1.0, SpaceLinearRgb)
//     println("${p.a}")                                    // 255
// ```
pub fn mix_pixel(a: Srgba8, b: Srgba8, t: Float, space: ColorSpace) -> Srgba8
    let cover = srgb.clamp_byte(math.round(lerp(a.a as Float, b.a as Float, t)) as Int)
    if cover == 0
        srgb.transparent()
    else
        let blended = blend(premultiply(a).rgb, premultiply(b).rgb, t, space, false)
        unpremultiply(srgb.with_alpha(blended, cover))

// Blend two colours in a cylindrical space, taking the long way round
// the hue circle.
//
// This is the escape from `mix`'s short-way default.  From 350° to 10°
// it travels 340° through the whole spectrum rather than 20° through
// red.  It is what a caller building a rainbow wants, and what CSS
// spells `longer hue`.
//
// A space that is not cylindrical has no hue to go the long way round,
// and this function then behaves as `mix` does.
// `colorspace.is_cylindrical` is the predicate that says which spaces
// are which.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     let c = colormix.mix_hue_long(srgb.black(), srgb.white(), 0.0, SpaceHsl)
//     println("${c.r}")                                    // 0
// ```
pub fn mix_hue_long(a: Srgb8, b: Srgb8, t: Float, space: ColorSpace) -> Srgb8
    blend(a, b, t, space, true)

// Whether a ramp's stops are in ascending order of position.
//
// The precondition `sample` relies on, checked once where the ramp is
// built rather than on every sample.  An empty ramp and a one-stop
// ramp are both sorted.
//
// ```novo
// use colormix
//
// fn main() [io]
//     println("${colormix.ramp_is_sorted([])}")            // true
// ```
pub fn ramp_is_sorted(stops: [ColorStop]) -> Bool
    var sorted = true
    for i in 1..list.len(stops)
        if stops[i].at < stops[i - 1].at
            sorted = false
    sorted

// The colour at a position in a ramp, interpolated in a named space.
//
// A position before the first stop answers the first stop's colour, and
// a position after the last answers the last.  A ramp does not
// extrapolate, because a gradient that ran off its own ends would put
// out-of-gamut colours in the corners of every fill.  That is the one
// place this module clamps where `mix` does not, and the difference is
// intended, because a ramp has ends and a two-colour mix does not.
//
// An empty ramp has no colour to answer with and panics.  A caller who
// might have one checks `stops.len()` first.  The signature offers no
// `Result` here, because a program that builds an empty gradient has a
// bug at the point it built it and not at the point it drew it.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     let ramp = [ColorStop { at: 0.0, color: srgb.black() }]
//     println("${colormix.sample(ramp, 0.5, SpaceOklab).r}")   // 0
// ```
pub fn sample(stops: [ColorStop], at: Float, space: ColorSpace) -> Srgb8
    let n = list.len(stops)
    if n == 0
        core.panic.panic("color-nv.colormix.sample: an empty ramp has no colour")
    elif at <= stops[0].at
        stops[0].color
    elif at >= stops[n - 1].at
        stops[n - 1].color
    else
        segment(stops, at, space)

// A ramp flattened to `n` evenly spaced colours.
//
// This is what a palette, a colour bar or a lookup table wants.  It
// samples once and is indexed afterwards.  An `n` of 1 answers the ramp
// at 0.0, and an `n` of 0 answers an empty list rather than panicking,
// because asking for no entries is a coherent request where a ramp with
// no stops is not.
//
// ```novo
// use colormix
//
// fn main() [io]
//     println("${colormix.ramp_table([], 0, SpaceOklab).len()}")   // 0
// ```
pub fn ramp_table(stops: [ColorStop], n: Int, space: ColorSpace) -> [Srgb8]
    var out: [Srgb8] = []
    for i in 0..n
        let here = sample(stops, position(i, n), space)
        out = list.push(out, here)
    out

// Multiply a pixel's channels by its own alpha.
//
// This is the conversion into associated alpha, also called
// premultiplied alpha.  It is the only representation in which
// averaging two pixels of different opacity is correct.  The conversion
// is lossy at low alpha.  At `a = 1` a channel keeps about one part in
// 255 of its precision, so a buffer that will be premultiplied and
// unpremultiplied repeatedly should stay premultiplied instead.
//
// The multiplication is on the stored channels, which is what a buffer
// held in premultiplied form contains and what `mix_pixel` blends.  It
// is not the same arithmetic as `over`, which undoes the transfer
// function first because a composite is arithmetic on light.  The two
// answer different numbers for the same pair.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     println("${colormix.premultiply(srgb.transparent()).rgb.r}")     // 0
// ```
pub fn premultiply(p: Srgba8) -> Srgba8
    let cover = p.a as Float / 255.0
    Srgba8 { rgb: Srgb8 { r: scale_byte(p.rgb.r, cover),
                          g: scale_byte(p.rgb.g, cover),
                          b: scale_byte(p.rgb.b, cover) },
             a: p.a }

// Divide a pixel's channels by its own alpha.
//
// The inverse, for handing a buffer to a format that stores
// unassociated alpha.  PNG and QOI both do.  A pixel with zero alpha
// has no colour to recover and comes back `srgb.transparent()`.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     println("${colormix.unpremultiply(srgb.transparent()).a}")       // 0
// ```
pub fn unpremultiply(p: Srgba8) -> Srgba8
    if p.a == 0
        srgb.transparent()
    else
        let cover = 255.0 / p.a as Float
        Srgba8 { rgb: Srgb8 { r: scale_byte(p.rgb.r, cover),
                              g: scale_byte(p.rgb.g, cover),
                              b: scale_byte(p.rgb.b, cover) },
                 a: p.a }

// Composite a source pixel over a destination pixel.
//
// This is Porter–Duff `over`, done in linear light.  It is the
// operation an alpha blend is, and the one an image compositor is built
// out of.  Both operands are unassociated on the way in and the result
// is unassociated on the way out, and the premultiplication happens
// inside.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     let p = colormix.over(srgb.transparent(), srgb.opaque(srgb.white()))
//     println("${p.rgb.r}")                                // 255
// ```
pub fn over(src: Srgba8, dst: Srgba8) -> Srgba8
    let sa = src.a as Float / 255.0
    let da = dst.a as Float / 255.0
    let oa = sa + da * (1.0 - sa)
    if oa <= 0.0
        srgb.transparent()
    else
        let sl = colorspace.to_linear(srgb.to_srgb(src.rgb))
        let dl = colorspace.to_linear(srgb.to_srgb(dst.rgb))
        let out = LinearRgb { r: composite(sl.r, sa, dl.r, da, oa),
                              g: composite(sl.g, sa, dl.g, da, oa),
                              b: composite(sl.b, sa, dl.b, da, oa) }
        srgb.with_alpha(srgb.to_srgb8(colorspace.to_srgb(out)),
                        srgb.clamp_byte(math.round(oa * 255.0) as Int))

// A colour with its lightness moved by a fraction, in a named space.
//
// A positive amount lightens towards white and a negative one darkens
// towards black.  The amount is a fraction of the remaining distance
// rather than an absolute step, so `lighten(c, 1.0)` is white for every
// `c` and two applications of 0.5 do not reach it.  That is the
// behaviour a design system's lighter token wants, and the absolute
// form is `mix(c, white, amount, space)`.
//
// The space decides what lightness means.  `SpaceHsl` moves the `l`
// channel and matches every design tool.  `SpaceCieLab` and
// `SpaceOklab` move perceptual lightness and keep the hue where a
// person sees it.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     println("${colormix.lighten(srgb.black(), 1.0, SpaceHsl).r}")    // 255
// ```
pub fn lighten(c: Srgb8, amount: Float, space: ColorSpace) -> Srgb8
    let v = to_chan(c, space)
    match space
        SpaceHsl    => from_chan(Chan { a: v.a, b: v.b, c: toward(v.c, amount, 1.0) }, space)
        SpaceHsv    => from_chan(Chan { a: v.a, b: v.b, c: toward(v.c, amount, 1.0) }, space)
        SpaceCieLab => from_chan(Chan { a: toward(v.a, amount, 100.0), b: v.b, c: v.c }, space)
        SpaceOklab  => from_chan(Chan { a: toward(v.a, amount, 1.0), b: v.b, c: v.c }, space)
        _           => blend(c, ink(amount), math.abs(amount), space, false)

// A colour with its saturation moved by a fraction, in a named space.
//
// A positive amount saturates and a negative one desaturates.  `-1.0`
// is the grey of the same lightness, which is not the same grey in HSL
// as in Lab.  That is why the space is a parameter here too.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     println("${colormix.saturate(srgb.white(), -1.0, SpaceHsl).r}")  // 255
// ```
pub fn saturate(c: Srgb8, amount: Float, space: ColorSpace) -> Srgb8
    let v = to_chan(c, space)
    match space
        SpaceHsl    => from_chan(Chan { a: v.a, b: toward(v.b, amount, 1.0), c: v.c }, space)
        SpaceHsv    => from_chan(Chan { a: v.a, b: toward(v.b, amount, 1.0), c: v.c }, space)
        SpaceCieLab => from_chan(Chan { a: v.a, b: v.b * (1.0 + amount), c: v.c * (1.0 + amount) }, space)
        SpaceOklab  => from_chan(Chan { a: v.a, b: v.b * (1.0 + amount), c: v.c * (1.0 + amount) }, space)
        _           => blend(to_grey(c), c, 1.0 + amount, space, false)

// A colour with its hue rotated by an angle in degrees.
//
// The angle wraps, so 370.0 and 10.0 are the same rotation and a
// negative angle goes the other way.  Greys have no hue and come back
// unchanged rather than acquiring one.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     println("${colormix.rotate_hue(srgb.white(), 120.0, SpaceHsl).g}")   // 255
// ```
pub fn rotate_hue(c: Srgb8, degrees: Float, space: ColorSpace) -> Srgb8
    match space
        SpaceCieLab => from_chan(spin(to_chan(c, SpaceCieLab), degrees), SpaceCieLab)
        SpaceOklab  => from_chan(spin(to_chan(c, SpaceOklab), degrees), SpaceOklab)
        SpaceCieXyz => from_chan(spin(to_chan(c, SpaceCieLab), degrees), SpaceCieLab)
        _           => from_chan(turn(to_chan(c, SpaceHsl), degrees), SpaceHsl)

// The grey of the same relative luminance as a colour.
//
// This is luminance-preserving desaturation, computed in linear light,
// which is what makes a greyscale conversion look like the photograph
// rather than like a flat wash.  Averaging the three encoded channels
// instead is the common shortcut, and it answers 85 for every primary.
// That is too dark for red, whose light is 0.2127 and whose grey is
// byte 127, and slightly too light for blue, whose light is 0.0722 and
// whose grey is byte 76.  A red and a blue that a viewer sees as very
// different lightnesses come out of the shortcut identical.
//
// The luminance is CIE Y through `colorspace.to_xyz`.  That is the same
// quantity `contrast.relative_luminance` answers, and within 1e-7 of
// the same number.  That function says why the two differ at all.
//
// ```novo
// use colormix
// use srgb
//
// fn main() [io]
//     println("${colormix.to_grey(srgb.white()).b}")       // 255
// ```
pub fn to_grey(c: Srgb8) -> Srgb8
    let y = colorspace.to_xyz(colorspace.to_linear(srgb.to_srgb(c))).y
    srgb.to_srgb8(colorspace.to_srgb(LinearRgb { r: y, g: y, b: y }))
