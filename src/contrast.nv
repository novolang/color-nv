// contrast.nv — WCAG relative luminance, the contrast ratio built on
// it, and the pass/fail thresholds as functions a caller calls rather
// than numbers a caller has to remember.
//
// The thresholds are functions rather than constants.  WCAG 2.2 has
// four numbers, 3.0, 4.5, 7.0 and 3.0 again for non-text, and which one
// applies depends on the conformance level, the text size and the font
// weight together.  Large means 18 point, or 14 point bold, rather than
// any single pixel size.  A constant called `AA_THRESHOLD` would put
// the whole of that decision on the caller, and the hard part is not
// the number but which number.  This module exposes
// `meets_aa(ratio, is_large)` and its siblings, and the constants stay
// inside, where the rule that selects them lives.
//
// Four things here come from the specification.  They are the relative
// luminance formula, which is the sRGB transfer function and then the
// 0.2126 / 0.7152 / 0.0722 weights, the `(L1 + 0.05) / (L2 + 0.05)`
// ratio with its 0.05 flare term, the four thresholds, and the
// 18 point and 14 point bold definition of large text.
//
// How far apart two colours look is not in the specification.  WCAG's
// ratio is a photometric quantity and is known to disagree with
// perception.  It rates white on orange as passing and dark grey on
// black as failing, where a reader would say the opposite.  APCA is the
// successor being drafted for WCAG 3 and is not declared here.  Its
// exponents changed twice in 2022, and a package that shipped a version
// of it would be publishing a moving target as though it were a
// standard.  `difference` below answers the perceptual question in CIE
// Lab instead, which has an ISO number behind it.
//
// The order of the arguments does not matter.  `ratio(a, b)` and
// `ratio(b, a)` are the same number, because the formula puts the
// lighter colour on top itself.  A caller never has to know which of a
// foreground and a background is lighter.

use srgb
use colorspace
use colormix
use std.math

// WCAG 2.2's flare term, which stands for the light a real screen
// reflects.  It is added to both luminances before they are divided.
// Without it black against black would be a division by zero rather
// than 1.0, and the ratio of two very dark colours would run away to
// infinity where a reader sees almost nothing.
const FLARE: Float = 0.05

// How many lightness steps `nearest_passing` tries between a colour and
// the end of the scale it is searching towards.
//
// The search is a scan of 256 steps rather than a bisection.  The
// answer has to be a colour that exists as three bytes, and the pass
// predicate is not monotonic in lightness at the last level or two,
// because rounding to a byte moves the ratio by a few thousandths
// either way.  A bisection can therefore step over the nearest passing
// colour and answer a further one.  A scan outwards from the colour
// answers the nearest by construction, and 256 steps is finer than the
// 8-bit scale it lands on.
const SEARCH_STEPS: Int = 256

// The ratio of two relative luminances, lighter over darker.
//
// Split out because `ratio` and `ratio_over` differ only in which
// colours they measure.  This is also where the argument order stops
// mattering, because the formula sorts its own operands.
fn ratio_of(a: Float, b: Float) -> Float
    (math.max(a, b) + FLARE) / (math.min(a, b) + FLARE)

// A stored colour as CIE L*a*b* against D65.
//
// sRGB is a D65 space, so that is the white point a difference between
// two screen colours is measured against.  `colorspace.adapt` is the
// caller's route to any other.
fn lab_of(c: Srgb8) -> CieLab
    colorspace.to_lab(colorspace.to_xyz(colorspace.to_linear(srgb.to_srgb(c))), WhiteD65)

// The relative luminance of a colour, `0.0 ..= 1.0`.
//
// WCAG 2.2 defines it as two steps.  Undo the sRGB transfer function on
// each channel, then weight them 0.2126 red, 0.7152 green and 0.0722
// blue.  Black is 0.0 and white is 1.0 exactly.
//
// The transfer function is the step that gets skipped, and skipping it
// is not a small error.  Pure blue's encoded average is 0.333 and its
// relative luminance is 0.0722, so a contrast checker that averaged the
// bytes would rate blue on black as passing.
//
// This is the same quantity as `CieXyz.y`, and it is spelled again here
// because a caller doing an accessibility check should not have to know
// that.  The two are not bit-identical.  WCAG rounds the weights to
// four decimals and Lindbloom's matrix carries seven, so
// `colorspace.to_xyz` of the linear form answers within 1e-7 of this.
// These three weights are the normative ones and they sum to exactly 1,
// which is why black is 0.0 and white is 1.0 here with nothing to
// round.
//
// ```novo
// use contrast
// use srgb
//
// fn main() [io]
//     println("${contrast.relative_luminance(srgb.white())}")      // 1
// ```
pub fn relative_luminance(c: Srgb8) -> Float
    let lin = colorspace.to_linear(srgb.to_srgb(c))
    0.2126 * lin.r + 0.7152 * lin.g + 0.0722 * lin.b

// The WCAG contrast ratio between two colours, `1.0 ..= 21.0`.
//
// The formula is `(lighter + 0.05) / (darker + 0.05)`, and the order of
// the arguments does not matter.  The 0.05 is a flare term standing in
// for the light a real screen reflects.  Without it black on black
// would be a division by zero rather than 1.0.
//
// Both ends of the range are exact.  A colour against itself is 1.0,
// and black against white is 21.0.
//
// ```novo
// use contrast
// use srgb
//
// fn main() [io]
//     println("${contrast.ratio(srgb.black(), srgb.white())}")     // 21
// ```
pub fn ratio(a: Srgb8, b: Srgb8) -> Float
    ratio_of(relative_luminance(a), relative_luminance(b))

// The contrast ratio between a translucent foreground and an opaque
// background.
//
// A ratio computed against the foreground's own colour is meaningless
// when that colour is 40% transparent, because what the reader sees is
// the composite.  This function composites first, in linear light, and
// measures that.  The background's own alpha is ignored.  WCAG's model
// assumes something opaque behind the whole stack, and a caller with
// several translucent layers composites them down before asking.
//
// Compositing in linear light is not what a browser does.  CSS
// compositing is specified on the gamma-encoded channels, so a browser
// paints black at 50% over white as `#808080`.  This function measures
// the composite a camera would have recorded, which is lighter: 1.92
// against white where a browser's pixel gives 3.95.  Compositing is
// arithmetic on light throughout this package, and `colormix.over` is
// linear for the same reason.  A caller auditing a page as it is
// painted should composite with the renderer's rule and pass `ratio`
// the colour that comes out.
//
// ```novo
// use contrast
// use srgb
//
// fn main() [io]
//     let fg = srgb.opaque(srgb.black())
//     println("${contrast.ratio_over(fg, srgb.white())}")          // 21
// ```
pub fn ratio_over(fg: Srgba8, bg: Srgb8) -> Float
    let over = colormix.over(fg, srgb.opaque(bg))
    ratio_of(relative_luminance(over.rgb), relative_luminance(bg))

// Whether a ratio meets WCAG 2.2 level AA for text.
//
// The threshold is 4.5 for normal text and 3.0 for large.  `is_large`
// means 18 point or larger, or 14 point or larger and bold.  That
// two-part rule is why the argument is a boolean the caller computes
// from their own typography rather than a size this package takes.
//
// ```novo
// use contrast
//
// fn main() [io]
//     println("${contrast.meets_aa(4.5, false)}")                  // true
// ```
pub fn meets_aa(ratio: Float, is_large: Bool) -> Bool
    if is_large
        ratio >= 3.0
    else
        ratio >= 4.5

// Whether a ratio meets WCAG 2.2 level AAA for text.
//
// The threshold is 7.0 for normal text and 4.5 for large.  AAA at large
// text is therefore the same number as AA at normal text, which is
// worth knowing before a design is rejected for missing a level it
// already met at a bigger size.
//
// ```novo
// use contrast
//
// fn main() [io]
//     println("${contrast.meets_aaa(7.0, false)}")                 // true
// ```
pub fn meets_aaa(ratio: Float, is_large: Bool) -> Bool
    if is_large
        ratio >= 4.5
    else
        ratio >= 7.0

// Whether a ratio meets WCAG 2.2's non-text contrast rule.
//
// The threshold is 3.0 for every user-interface component and graphical
// object.  The border of an input, the bars of a chart and an icon that
// carries meaning are all of that kind.  It is separate from `meets_aa`
// because it is a different success criterion, 1.4.11 rather than
// 1.4.3, and because a caller reaching for the text rule by habit
// applies 4.5 to a chart axis and fails a design that conforms.
//
// ```novo
// use contrast
//
// fn main() [io]
//     println("${contrast.meets_non_text(3.0)}")                   // true
// ```
pub fn meets_non_text(ratio: Float) -> Bool
    ratio >= 3.0

// The highest WCAG level a ratio reaches for text of a given size, as
// a word.
//
// The answer is `"AAA"`, `"AA"` or `"fail"`, for a report, a linter's
// output or a column in a table.  A caller deciding something calls
// `meets_aa` or `meets_aaa` instead.
//
// ```novo
// use contrast
//
// fn main() [io]
//     println("${contrast.level_name(21.0, false)}")               // AAA
// ```
pub fn level_name(ratio: Float, is_large: Bool) -> Str
    if meets_aaa(ratio, is_large)
        "AAA"
    elif meets_aa(ratio, is_large)
        "AA"
    else
        "fail"

// The lightest or darkest version of a colour that still meets a
// target ratio against a background.
//
// This is the function a theme generator wants.  It answers which
// nearby colour passes, rather than whether this one does.  Lightness
// is moved in Oklab, so the hue and chroma a designer chose survive.
// `lighter` says which direction to search, and the search stops at
// white or black.
//
// The answer is `None` when the target is unreachable in that
// direction.  A 7.0 ratio against mid-grey has no answer either way,
// and answering with white would be a wrong number rather than no
// number.
//
// ```novo
// use contrast
// use srgb
//
// fn main() [io]
//     match contrast.nearest_passing(srgb.white(), srgb.white(), 21.0, true)
//         Some(_) => println("found")
//         None    => println("unreachable")                        // this one
// ```
pub fn nearest_passing(c: Srgb8, bg: Srgb8, target: Float, lighter: Bool) -> ?Srgb8
    let start = colorspace.srgb_to_oklab(srgb.to_srgb(c))
    let end = if lighter
        1.0
    else
        0.0
    var found: ?Srgb8 = None
    for step in 0..=SEARCH_STEPS
        let t = step as Float / SEARCH_STEPS as Float
        let here = srgb.to_srgb8(colorspace.oklab_to_srgb(
            CieLab { l: start.l + (end - start.l) * t, a: start.a, b: start.b }))
        if ratio(here, bg) >= target
            found = Some(here)
            break
    found

// Whether black or white text reads better on a background.
//
// The one-line answer to the question every badge, chip and chart label
// asks.  It compares the two ratios rather than thresholding the
// luminance at 0.5, which is the shortcut that puts white text on
// yellow.
//
// ```novo
// use contrast
// use srgb
//
// fn main() [io]
//     println("${contrast.best_ink(srgb.white()).r}")              // 0
// ```
pub fn best_ink(bg: Srgb8) -> Srgb8
    if ratio(bg, srgb.black()) >= ratio(bg, srgb.white())
        srgb.black()
    else
        srgb.white()

// How different two colours look, as a CIE Lab ΔE*ab distance.
//
// This is the perceptual question WCAG's ratio does not answer.  The
// formula is ΔE*76, plain Euclidean distance in Lab against D65.
// Roughly 2.3 is the distance at which a person notices a difference at
// all, and 5 is obvious.  ΔE*76 is the oldest and least accurate of the
// ΔE formulas, and it is the one here because a reader can predict its
// number.  ΔE*2000 is a better model whose piecewise weighting makes a
// result impossible to check by hand.
//
// This is not a contrast measure and must not be used as one.  Two
// colours can be far apart in Lab and have almost identical luminance,
// which is the pair a person with a colour-vision deficiency cannot
// separate.
//
// ```novo
// use contrast
// use srgb
//
// fn main() [io]
//     println("${contrast.difference(srgb.white(), srgb.white())}")    // 0
// ```
pub fn difference(a: Srgb8, b: Srgb8) -> Float
    let la = lab_of(a)
    let lb = lab_of(b)
    math.sqrt((la.l - lb.l) * (la.l - lb.l)
              + (la.a - lb.a) * (la.a - lb.a)
              + (la.b - lb.b) * (la.b - lb.b))
