        0xff00   => Some("lime")
        0x32cd32 => Some("limegreen")
        0xfaf0e6 => Some("linen")
        0x800000 => Some("maroon")
        0x66cdaa => Some("mediumaquamarine")
        0xcd     => Some("mediumblue")
        0xba55d3 => Some("mediumorchid")
