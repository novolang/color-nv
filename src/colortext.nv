// colortext.nv — a colour written down: the hex forms, the CSS
// functional forms, the 148 named colours, and the errors a caller
// gets when the text is not one of them.
//
// WHAT IS SPECIFICATION HERE
//
// CSS Color Module Level 4 is the reference, and it is a real
// specification rather than one implementation's habits: the four hex
// lengths, the `rgb()` / `rgba()` / `hsl()` / `hsla()` grammars with
// both the comma and the space separator, the percentage-or-number
// channel rule, and the named-colour table with its one historical
// oddity (`gray` and `grey` are both spellings, `darkgray` and
// `darkgrey` too, and `green` is `#008000` rather than `#00ff00`).
//
// WHAT THIS PACKAGE REFUSES TO GUESS
//
// A bare `c0ffee` with no `#`, a colour name in title case, a
// three-digit form with an alpha appended.  Every one of them is a
// thing some parser somewhere accepts, and every one of them makes a
// typo in a config file silently become a colour.  This parser is
// strict and the error says which rule was broken, because the caller
// who wanted lenience can lower-case and prefix the input themselves
// and the caller who wanted strictness cannot get it back.
//
// FORMATTING IS NOT PARSING'S INVERSE, ON PURPOSE
//
// `format_hex` always writes the six-digit lower-case form, even for
// a colour the three-digit form could have carried.  A round trip
// through this module is therefore text-lossy and colour-exact, which
// is the direction that matters: two files that disagree only in
// their hex shorthand should diff as equal after a format pass.

use srgb
use colorspace
use std.str
use std.list
use std.fmt
use std.math

// The lower-case hexadecimal alphabet, indexed by nibble.
//
// A string rather than a match because `format_hex` wants the digit for
// a number and `parse_hex` wants the number for a digit, and one table
// read in both directions cannot disagree with itself.
const HEX_DIGITS: Str = "0123456789abcdef"

// The 148 CSS colour keywords, packed as `0xRRGGBB`, or -1 for a name
// that is not one of them.
//
// A `match` on the name rather than a list walked at run time: the
// table is fixed at compile time and the compiler turns the arms into a
// switch, so a lookup costs neither a comparison per keyword nor an
// allocation.  `transparent` is NOT here — it is the one keyword whose
// value is not a colour but a colour AND an alpha, and `named` answers
// it before asking this.
//
// Both spellings of every `gray`/`grey` pair are present, and so are
// `aqua`/`cyan` and `fuchsia`/`magenta`: CSS carries all nine
// duplicates and a parser that dropped one would refuse a stylesheet
// that is valid.
fn keyword_rgb(name: Str) -> Int
    match name
        "aliceblue"            => 0xf0f8ff
        "antiquewhite"         => 0xfaebd7
        "aqua"                 => 0x00ffff
        "aquamarine"           => 0x7fffd4
        "azure"                => 0xf0ffff
        "beige"                => 0xf5f5dc
        "bisque"               => 0xffe4c4
        "black"                => 0x000000
        "blanchedalmond"       => 0xffebcd
        "blue"                 => 0x0000ff
        "blueviolet"           => 0x8a2be2
        "brown"                => 0xa52a2a
        "burlywood"            => 0xdeb887
        "cadetblue"            => 0x5f9ea0
        "chartreuse"           => 0x7fff00
        "chocolate"            => 0xd2691e
        "coral"                => 0xff7f50
        "cornflowerblue"       => 0x6495ed
        "cornsilk"             => 0xfff8dc
        "crimson"              => 0xdc143c
        "cyan"                 => 0x00ffff
        "darkblue"             => 0x00008b
        "darkcyan"             => 0x008b8b
        "darkgoldenrod"        => 0xb8860b
        "darkgray"             => 0xa9a9a9
        "darkgreen"            => 0x006400
        "darkgrey"             => 0xa9a9a9
        "darkkhaki"            => 0xbdb76b
        "darkmagenta"          => 0x8b008b
        "darkolivegreen"       => 0x556b2f
        "darkorange"           => 0xff8c00
        "darkorchid"           => 0x9932cc
        "darkred"              => 0x8b0000
        "darksalmon"           => 0xe9967a
        "darkseagreen"         => 0x8fbc8f
        "darkslateblue"        => 0x483d8b
        "darkslategray"        => 0x2f4f4f
        "darkslategrey"        => 0x2f4f4f
        "darkturquoise"        => 0x00ced1
        "darkviolet"           => 0x9400d3
        "deeppink"             => 0xff1493
        "deepskyblue"          => 0x00bfff
        "dimgray"              => 0x696969
        "dimgrey"              => 0x696969
        "dodgerblue"           => 0x1e90ff
        "firebrick"            => 0xb22222
        "floralwhite"          => 0xfffaf0
