        "gainsboro"            => 0xdcdcdc
        "ghostwhite"           => 0xf8f8ff
        "gold"                 => 0xffd700
        "goldenrod"            => 0xdaa520
        "gray"                 => 0x808080
        "green"                => 0x008000
        "greenyellow"          => 0xadff2f
        "grey"                 => 0x808080
        "honeydew"             => 0xf0fff0
        "hotpink"              => 0xff69b4
        "indianred"            => 0xcd5c5c
        "indigo"               => 0x4b0082
        "ivory"                => 0xfffff0
        "khaki"                => 0xf0e68c
        "lavender"             => 0xe6e6fa
        "lavenderblush"        => 0xfff0f5
        "lawngreen"            => 0x7cfc00
        "lemonchiffon"         => 0xfffacd
        "lightblue"            => 0xadd8e6
        "lightcoral"           => 0xf08080
