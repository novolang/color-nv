        0xf5f5f5 => Some("whitesmoke")
        0xffff00 => Some("yellow")
        0x9acd32 => Some("yellowgreen")
        _        => None

// The six-digit lower-case hex form, with the `#`.
//
// Always six digits: `#ff0000` rather than `#f00`, so that two files
// formatted by this function compare as text.
//
// ```novo
// use colortext
//
// fn main() [io]
//     println("${colortext.format_hex(Srgb8 { r: 255, g: 0, b: 0 })}")     // #ff0000
// ```
pub fn format_hex(c: Srgb8) -> Str
    "#" + hex2(c.r) + hex2(c.g) + hex2(c.b)

// The eight-digit lower-case hex form, with the `#`.
//
// The alpha is the last pair, which is CSS's order and the opposite of
// the `#AARRGGBB` that Android and several Java APIs use — a caller
// moving values between the two has to swap, and this is the place
// that says so.
//
// ```novo
// use colortext
//
// fn main() [io]
//     let p = srgb.opaque(Srgb8 { r: 255, g: 0, b: 0 })
//     println("${colortext.format_hex_alpha(p)}")                     // #ff0000ff
// ```
pub fn format_hex_alpha(p: Srgba8) -> Str
    format_hex(p.rgb) + hex2(p.a)

// The CSS `rgb()` form with space separators.
//
// `rgb(255 0 0)` — the modern grammar, which is what CSS Color 4
// prefers and what a stylesheet written today should carry.  The
// comma form is still parsed and is not written.
//
// ```novo
// use colortext
//
// fn main() [io]
//     println("${colortext.format_rgb(Srgb8 { r: 255, g: 0, b: 0 })}")     // rgb(255 0 0)
// ```
pub fn format_rgb(c: Srgb8) -> Str
    "rgb(${c.r} ${c.g} ${c.b})"

// The CSS `rgb()` form with a slash-separated alpha.
//
// `rgb(255 0 0 / 0.5)`, and the alpha is omitted entirely when it is
// fully opaque, because a stylesheet full of `/ 1` is noise.
//
// ```novo
// use colortext
//
// fn main() [io]
//     let p = srgb.opaque(Srgb8 { r: 255, g: 0, b: 0 })
//     println("${colortext.format_rgba(p)}")                          // rgb(255 0 0)
// ```
pub fn format_rgba(p: Srgba8) -> Str
    if p.a == 255
        format_rgb(p.rgb)
    else
        "rgb(${p.rgb.r} ${p.rgb.g} ${p.rgb.b} / ${alpha_text(p.a)})"

// The CSS `hsl()` form with space separators.
//
// `hsl(0 100% 50%)`.  The hue is written without a unit, which CSS
// permits and every engine reads; saturation and lightness carry
// their percent signs, which CSS requires.
//
// ```novo
// use colortext
//
// fn main() [io]
//     println("${colortext.format_hsl(Srgb8 { r: 255, g: 0, b: 0 })}")     // hsl(0 100% 50%)
// ```
pub fn format_hsl(c: Srgb8) -> Str
    let h = colorspace.srgb_to_hsl(srgb.to_srgb(c))
    "hsl(${short_number(h.h)} ${short_number(h.s * 100.0)}% ${short_number(h.l * 100.0)}%)"
